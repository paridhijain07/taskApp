{
  "info": {
    "name": "TaskApp REST API",
    "description": "Postman collection for the TaskApp REST API (JWT + refresh token + RBAC).",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paridhi\",\n  \"email\": \"paridhi@test.com\",\n  \"password\": \"Admin@1234\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user1@test.com\",\n  \"password\": \"User@1234\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Auth - Refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"<put-refresh-token-here>\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
      }
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <access-token-here>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"<put-refresh-token-here>\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
      }
    },
    {
      "name": "Users - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <access-token-here>" }],
        "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
      }
    },
    {
      "name": "Users - Update Me",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <access-token-here>" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}\n" },
        "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
      }
    },
    {
      "name": "Users - Change Password",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <access-token-here>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"User@1234\",\n  \"newPassword\": \"User@2345\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/users/me/password", "host": ["{{baseUrl}}"], "path": ["users", "me", "password"] }
      }
    },
    {
      "name": "Tasks - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <access-token-here>" }],
        "url": { "raw": "{{baseUrl}}/tasks?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "Tasks - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <access-token-here>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New task from Postman\",\n  \"description\": \"Created via Postman\",\n  \"status\": \"pending\",\n  \"priority\": \"medium\"\n}\n"
        },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "Tasks - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <access-token-here>" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}\n" },
        "url": { "raw": "{{baseUrl}}/tasks/<taskId>", "host": ["{{baseUrl}}"], "path": ["tasks", "<taskId>"] }
      }
    },
    {
      "name": "Tasks - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer <access-token-here>" }],
        "url": { "raw": "{{baseUrl}}/tasks/<taskId>", "host": ["{{baseUrl}}"], "path": ["tasks", "<taskId>"] }
      }
    }
  ]
}

